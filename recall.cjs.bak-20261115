const { DatabaseSync } = require('node:sqlite');
const DB = 'D:/qq-bridge/state/recall/recall.db';
const args = process.argv.slice(2);
if (!args.length) { console.log('usage: node recall.cjs <关键词> [--since YYYY-MM-DD] [--who 他|鱼] [--limit N] [--around]'); process.exit(1); }
let q = null, since = null, who = null, limit = 15, around = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--since') since = args[++i];
  else if (a === '--who') who = args[++i];
  else if (a === '--limit') limit = parseInt(args[++i], 10) || 15;
  else if (a === '--around') around = true;
  else if (q === null) q = a;
}
const db = new DatabaseSync(DB);
const pad = n => String(n).padStart(2, '0');
const fmt = ts => { const d = new Date(ts); return `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`; };
const where = [], params = [];
if (since) { where.push('day >= ?'); params.push(since); }
if (who) { where.push('who = ?'); params.push(who); }
let rows = [];
if ([...q].length >= 3) {
  const sql = `SELECT m.id, m.ts, m.day, m.who, m.text FROM fts f JOIN msgs m ON m.id = f.rowid WHERE fts MATCH ?` + (where.length ? ' AND ' + where.join(' AND ') : '') + ` ORDER BY m.ts DESC LIMIT ${limit}`;
  rows = db.prepare(sql).all('"' + q.replace(/"/g, '""') + '"', ...params);
}
if (!rows.length) {
  const sql = `SELECT id, ts, day, who, text FROM msgs WHERE text LIKE ?` + (where.length ? ' AND ' + where.join(' AND ') : '') + ` ORDER BY ts DESC LIMIT ${limit}`;
  rows = db.prepare(sql).all('%' + q + '%', ...params);
}
if (!rows.length) { console.log('(没找到)'); process.exit(0); }
const clean = t => t.replace(/\s+/g, ' ');
console.log(`命中 ${rows.length} 条（关键词：${q}${since ? '，起 ' + since : ''}${who ? '，只 ' + who : ''}）`);
for (const r of rows) console.log(`[${fmt(r.ts)}] ${r.who}：${clean(r.text).slice(0, 220)}`);
if (around) {
  const top = rows[0];
  console.log('\n—— 那一条的上下文 ——');
  const ctx = db.prepare('SELECT ts, who, text FROM msgs WHERE ts BETWEEN ? AND ? ORDER BY ts ASC').all(top.ts - 40 * 60000, top.ts + 40 * 60000);
  for (const c of ctx) console.log(`[${fmt(c.ts)}] ${c.who}：${clean(c.text).slice(0, 200)}`);
}
db.close();